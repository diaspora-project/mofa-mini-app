# mofa-mini-app secrets template — copy to `.env` (gitignored) and fill in.
#
# The Octopus credentials below are NOT consumed by mofa.diaspora.DiasporaQueues
# at runtime — it mints fresh AWS keys via GlobusClient.create_key() at startup
# (see mof-generation-at-scale/mofa/diaspora.py L77-L88). The variables are
# kept only for parity with external scripts that bypass Globus auth.
#
# To bootstrap Octopus tokens the first time:
#
#     docker compose --profile octopus run --rm octopus-thinker \
#         python tests/smoke_octopus.py
#
# That walks an interactive Globus login and caches tokens at
# ~/.diaspora/storage.db. The `diaspora-storage` named volume in
# docker-compose.yml persists those tokens across container restarts.

# OCTOPUS_AWS_ACCESS_KEY_ID=
# OCTOPUS_AWS_SECRET_ACCESS_KEY=
# OCTOPUS_BOOTSTRAP_SERVERS=
